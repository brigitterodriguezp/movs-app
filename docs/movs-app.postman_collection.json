              "host": ["{{base_url}}"],
              "path": ["api", "peliculas"]
            }
          }
        },
        {
          "name": "Obtener película por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/peliculas/1",
              "host": ["{{base_url}}"],
              "path": ["api", "peliculas", "1"]
            }
          }
        },
        {
          "name": "Listar por género",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/peliculas/genero/Drama",
              "host": ["{{base_url}}"],
              "path": ["api", "peliculas", "genero", "Drama"]
            }
          }
        },
        {
          "name": "Buscar por título",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/peliculas/buscar?titulo=Cover",
              "host": ["{{base_url}}"],
              "path": ["api", "peliculas", "buscar"],
              "query": [
                { "key": "titulo", "value": "Cover" }
              ]
            }
          }
        },
        {
          "name": "Crear película",
          "request": {
            "method": "POST",
