{
  "info": {
    "name": "Movs App API",
    "description": "Colección para testear todos los endpoints de Movs App.\n\nVariables de colección:\n- `base_url`: `http://localhost:8080`\n- `token`: se asigna automáticamente tras login\n- `usuario_id`: ID de prueba\n- `plan_id`: ID de prueba\n- `suscripcion_id`: ID de prueba\n- `pelicula_id`: ID de prueba",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('usuario_id', json.usuarioId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"correo\":\"ana@example.com\",\"password\":\"ClaveSegura123\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        },
        {
          "name": "Consultar sesión",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/sesion/{{usuario_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "sesion", "{{usuario_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Nuevo Usuario\",\"correo\":\"nuevo@example.com\",\"password\":\"ClaveSegura123\",\"rol\":\"usuario\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios"]
            }
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios"]
            }
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/usuarios/{{usuario_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "{{usuario_id}}"]
            }
          }
        },
        {
          "name": "Obtener perfil actual (me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/usuarios/me",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "me"]
            }
          }
        },
        {
          "name": "Listar por rol",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/usuarios/rol/usuario",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "rol", "usuario"]
            }
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Ana Pérez Actualizada\",\"correo\":\"ana.actualizado@example.com\",\"password\":\"NuevaClave123\",\"rol\":\"usuario\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/usuarios/{{usuario_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "{{usuario_id}}"]
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/usuarios/{{usuario_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "{{usuario_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Planes",
      "item": [
        {
          "name": "Listar planes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/planes",
              "host": ["{{base_url}}"],
              "path": ["api", "planes"]
            }
          }
        },
        {
          "name": "Obtener plan por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/planes/1",
              "host": ["{{base_url}}"],
              "path": ["api", "planes", "1"]
            }
          }
        },
        {
          "name": "Crear plan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\":\"premium\",\"nombre\":\"Premium\",\"precio\":9.99,\"duracionDias\":30,\"beneficios\":[\"4 pantallas\",\"Calidad 4K\",\"Descargas ilimitadas\"]}"
            },
            "url": {
              "raw": "{{base_url}}/api/planes",
              "host": ["{{base_url}}"],
              "path": ["api", "planes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('plan_id', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actualizar plan",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\":\"basic\",\"nombre\":\"Basic Plus\",\"precio\":5.99,\"duracionDias\":30,\"beneficios\":[\"1 pantalla\",\"Calidad HD\",\"Subtítulos\"]}"
            },
            "url": {
              "raw": "{{base_url}}/api/planes/{{plan_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "planes", "{{plan_id}}"]
            }
          }
        },
        {
          "name": "Eliminar plan",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/planes/{{plan_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "planes", "{{plan_id}}"]
            }
          }
        }
      ]
    },
